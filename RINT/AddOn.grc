#include "ResourceIds.hpp"

'STR#' ID_ADDON_INFO "Add-on Name and Description" {
/* [  1] */		"ПСО и отделка"
/* [  2] */		"Ведомость отделки помещений по зонам HimeraZone: потолки и стены по материалу (монолит, кладка, ГКЛ), таблица на рабочем листе; паспорта квартир и ТЭП"
}

'STR#' ID_ADDON_MENU "Strings for the Menu" {
/* [   ] */		"ПСО и отделка"
/* [  1] */			"Ведомость отделки...^E3^ES^EE^EI^ED^EW^EL"
/* [  2] */			"Ведомость + таблица проверки зон^E3^ES^EE^EI^ED^EW^EL"
/* [  3] */			"Показать на плане зоны выделенных строк проверки^E3^ES^EE^EI^ED^EW^EL"
/* [  4] */			"Паспорта квартир на планах этажей^E3^ES^EE^EI^ED^EW^EL"
/* [  5] */			"ТЭП по дому (таблица на рабочем листе)^E3^ES^EE^EI^ED^EW^EL"
/* [  6] */			"Данные ТЭП и паспортов (файл)...^E3^ES^EE^EI^ED^EW^EL"
/* [  7] */			"Сохранить параметры зон в файл^E3^ES^EE^EI^ED^EW^EL"
/* [  8] */			"Восстановить параметры зон из файла^E3^ES^EE^EI^ED^EW^EL"
/* [  9] */			"Создать отделку пилонам...^E3^ES^EE^EI^ED^EW^EL"
}

