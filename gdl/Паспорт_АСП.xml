<Script_2D SectVersion="20" SectionFlags="0" SubIdent="0">
<![CDATA[
! Паспорт квартиры: слева тип (1К, 2К, С), справа 4 строки —
! жилая площадь, площадь квартиры, общая площадь (без коэф.), приведённая площадь (с коэф.).
! Ставит и обновляет надстройка «Ведомость отделки» (меню «Паспорта квартир на планах этажей»).
! Размеры — в мм листа; начало — левый нижний угол.

k = GLOB_SCALE / 1000
! в GDL имена переменных без учёта регистра: _h и _H — одна переменная, поэтому имена разные
! iKind = 0 — квартира: слева номер (верх) и тип (низ), справа 4 площади;
! iKind = 1 — встроенное помещение: слева «АП», справа номер, площадь, высота
_w1 = wCol1 * k
_w2 = wCol2 * k
_hr = hRow2 * k
_nRows = 4
if iKind = 1 then _nRows = 3
_wTot = _w1 + _w2
_hTot = _nRows * _hr
_num = iKind = 0 and bAptNum and stApt <> ""

hotspot2 0, 0
hotspot2 _wTot, 0
hotspot2 0, _hTot
hotspot2 _wTot, _hTot
hotspot2 _wTot / 2, _hTot / 2

pen gs_cont_pen
line2 0, 0, _wTot, 0
line2 _wTot, 0, _wTot, _hTot
line2 _wTot, _hTot, 0, _hTot
line2 0, _hTot, 0, 0
line2 _w1, 0, _w1, _hTot
for i = 1 to _nRows - 1
	line2 _w1, i * _hr, _wTot, i * _hr
next i
if _num then line2 _w1 * 0.1, _hTot / 2, _w1 * 0.9, _hTot / 2

pen gs_text_pen
_face = 0
if bTypeBold then _face = 1
define style "aspType" sFont, tSizeT, 5, _face
define style "aspArea" sFont, tSizeA, 5, 0

set style "aspType"
if _num then
	text2 _w1 / 2, _hTot * 0.25, stType
	set style "aspArea"
	text2 _w1 / 2, _hTot * 0.75, stApt
else
	text2 _w1 / 2, _hTot / 2, stType
endif

set style "aspArea"
dim _s[4]
if iKind = 1 then
	_s[1] = stApt
	_s[2] = stArea
	_s[3] = stHeight
else
	_s[1] = stLiving
	_s[2] = stArea
	_s[3] = stTotal
	_s[4] = stReduced
endif
for i = 1 to _nRows
	text2 _w1 + _w2 / 2, _hTot - (i - 0.5) * _hr, _s[i]
next i
]]>
</Script_2D>

